# --- Core ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# Get a free instance from Neon, Supabase, or Railway, or run Postgres via docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amis_properties?schema=public"

# --- JWT ---
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- SMS OTP (Twilio) — leave blank to log OTPs to the console in dev ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (SMTP, e.g. Gmail app password or SendGrid) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Media storage (Cloudinary) — leave blank to store uploads locally in /uploads ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments — add only the providers you've actually signed up with ---
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
